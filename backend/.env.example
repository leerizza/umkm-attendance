# Backend environment variables
# Set these in Railway dashboard → Variables

# Dari Supabase Dashboard → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# Comma-separated frontend URLs yang diizinkan (CORS)
# Setelah deploy Vercel, tambahkan URL Vercel kamu di sini
# Contoh: https://umkm-attendance.vercel.app,https://umkm-attendance-git-main-user.vercel.app
FRONTEND_URL=https://your-app.vercel.app
