{
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- .",
  "rewrites": [
    {
      "source": "/perbandingan",
      "destination": "/perbandingan.html"
    },
    {
      "source": "/kebijakan-privasi",
      "destination": "/kebijakan-privasi.html"
    },
    {
      "source": "/syarat-layanan",
      "destination": "/syarat-layanan.html"
    },
    {
      "source": "/((?!.*\\.pdf$)(?!robots\\.txt$)(?!sitemap\\.xml$)(?!google[a-z0-9]+\\.html$)(?!perbandingan)(?!kebijakan-privasi)(?!syarat-layanan).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
