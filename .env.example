# File ini TIDAK dipakai untuk Railway/Vercel deployment.
# Hanya untuk docker-compose lokal.
#
# Untuk Railway → set di dashboard Railway → Variables
# Untuk Vercel  → set di dashboard Vercel  → Settings → Environment Variables

# URL Railway backend (dapat setelah deploy Railway selesai)
VITE_API_URL=https://your-backend.up.railway.app

# Dari Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx
