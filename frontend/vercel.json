{
  "rewrites": [
    { "source": "/((?!\\.well-known|sw\\.js|registerSW\\.js|workbox-[^/]*\\.js).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ]
}
